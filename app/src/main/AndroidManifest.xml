<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions for Phase 1: Hardware key sequence, haptics, widget -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Permissions for Phase 2: Emergency Pipeline (SMS, Location, DND, Foreground Tracking) -->
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Permissions for Phase 6: Doze Whitelist Request (Battery Optimization Exemption) -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Package Visibility for Phase 4: App Protection & Work Profile detection (Android 11+) -->
    <queries>
        <!-- Financial Wallets (Pakistan) -->
        <package android:name="pk.com.telenor.phoenix" />
        <package android:name="com.techlogix.mobilinkcustomer" />
        <package android:name="pk.sadapay.app" />
        <package android:name="com.nayapay.wallet" />
        <!-- Banks (Pakistan) -->
        <package android:name="com.hbl.mobilebanking" />
        <package android:name="com.divergentsoftlabs.meezanbank" />
        <package android:name="com.mcb.mcblive" />
        <package android:name="com.ubl.digital" />
        <package android:name="com.alfa.mobile" />
        <!-- Messaging & Media -->
        <package android:name="com.whatsapp" />
        <package android:name="org.telegram.messenger" />
        <!-- Work Profile Sandbox Fallbacks -->
        <package android:name="net.typeblog.shelter" />
        <package android:name="com.oasisfeng.island" />
        <!-- OEM Vault Packages -->
        <package android:name="com.samsung.knox.securefolder" />
        <package android:name="com.transsion.phonemaster" />
        <package android:name="com.transsion.xhide" />
        <package android:name="com.miui.securitycenter" />
        <package android:name="com.coloros.safecenter" />
        <package android:name="com.oplus.safecenter" />
        <package android:name="com.iqoo.secure" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
        </intent>
    </queries>

    <application
        android:name=".DuressApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar"
        tools:targetApi="35">

        <!-- Main Activity -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize" />

        <!-- Launcher Alias: Default (Duress) -->
        <activity-alias
            android:name=".LauncherDefault"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/alias_default"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:targetActivity=".ui.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Launcher Alias: Calculator Disguise -->
        <activity-alias
            android:name=".LauncherCalculator"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_disguise_calc"
            android:label="@string/alias_calculator"
            android:roundIcon="@drawable/ic_disguise_calc"
            android:targetActivity=".ui.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Launcher Alias: Notes Disguise -->
        <activity-alias
            android:name=".LauncherNotes"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_disguise_note"
            android:label="@string/alias_notes"
            android:roundIcon="@drawable/ic_disguise_note"
            android:targetActivity=".ui.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Launcher Alias: Clock Disguise -->
        <activity-alias
            android:name=".LauncherClock"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_disguise_clock"
            android:label="@string/alias_clock"
            android:roundIcon="@drawable/ic_disguise_clock"
            android:targetActivity=".ui.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Accessibility Service for Volume Key Sequence Detection & Screen Locking (API 28+) -->
        <service
            android:name=".service.DuressAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Quick Settings Tile Service -->
        <service
            android:name=".service.DuressTileService"
            android:icon="@drawable/ic_qs_tile"
            android:label="@string/qs_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Home Screen Widget Provider -->
        <receiver
            android:name=".receiver.DuressWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.duress.app.ACTION_TRIGGER_WIDGET" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/duress_widget_info" />
        </receiver>

        <!-- Optional Device Admin Receiver for Screen Locking on API 26-27 or fallback -->
        <receiver
            android:name=".admin.DuressDeviceAdminReceiver"
            android:description="@string/device_admin_description"
            android:label="@string/device_admin_label"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- Live SOS Location Tracking Foreground Service (15 min refresh 60s) -->
        <service
            android:name=".pipeline.SosTrackingService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- Boot Completed Receiver for Phase 6 System Restore & Keep-Alive Verification -->
        <receiver
            android:name=".receiver.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
